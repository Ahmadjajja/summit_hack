# Copy to .env. Leave a key empty to use the mock for that part.
MONGODB_URI=                 # empty = in-memory mongomock
MONGODB_DB=tripcheck

SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-snap-1.1     # confirm with GET /v1/models

GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon  # confirm exact ID in AI Studio

AGENT_SEED_PHRASE=           # stable identity for the orchestrator uAgent
STRIPE_TEST_KEY=             # sk_test_... ONLY. Never a live key.

MAX_LOOPS=3
# Prices for the scoreboard, USD per 1M tokens. Confirm on each console.
SUBQ_PRICE_IN_PER_M=0.05
GEMINI_PRICE_IN_PER_M=2.00
GEMINI_PRICE_OUT_PER_M=10.00
