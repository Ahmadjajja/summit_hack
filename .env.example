# Copy to .env. Leave a key empty to use the mock for that part.
MONGODB_URI=                 # empty = in-memory mongomock
MONGODB_DB=tripcheck

SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-snap-1.1     # or DECISION_MODEL; confirm with GET /v1/models

GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon  # or VERIFIER_MODEL; confirm exact ID in AI Studio
VERIFIER_THINKING_LEVEL=low  # off | low | medium | high (medium ≈ 6-18 s per review)
VERIFIER_TIMEOUT_S=60

AGENT_SEED_PHRASE=           # REQUIRED before Agentverse: long random secret (agent identities derive from it)
STRIPE_TEST_KEY=             # sk_test_... ONLY. Never a live key.
STRIPE_PUBLISHABLE_KEY=      # pk_test_... ASI:One agent: embedded Stripe card in the Fetch.ai RequestPayment
STRIPE_SUCCESS_URL=https://agentverse.ai/payment-success  # where embedded Checkout returns
STRIPE_CHECKOUT=true         # web UI: pay on Stripe's hosted test Checkout (card 4242 4242 4242 4242)
PUBLIC_URL=http://localhost:8080  # where Stripe Checkout sends the traveller back

DEMO_NOW=                    # e.g. 2026-11-18T10:00:00 to demo mid-trip changes
MAX_LOOPS=3                  # MAX_REPAIR_ROUNDS also accepted
MOCK=                        # e.g. subq,gemini,asi forces mocks even with keys set
BOOKING_DRY_RUN=true         # true = mock payments; false + sk_test key = Stripe test mode
AGENTS_USE_MAILBOX=false     # true = register the chat agent on Agentverse (auto-connects with AGENTVERSE_API_KEY)
BOOKING_AGENTS_MAILBOX=false # true = also register the 5 booking agents on Agentverse
AIOHTTP_TRUST_ENV=false      # true = agents use HTTPS_PROXY (corporate/sandboxed networks)
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=             # Fetch.ai ASI:One: live web search for places the seed data doesn't cover
ASI_ONE_MODEL=asi1
LIVE_SEARCH=true             # false = never search the web (seed data only)
SEARCH_TIMEOUT_S=150
DEFAULT_ORIGIN=SFO           # flights leave from here unless the message says 'from ...'
# Prices for the scoreboard, USD per 1M tokens. Confirm on each console.
SUBQ_PRICE_IN_PER_M=0.05
GEMINI_PRICE_IN_PER_M=2.00
GEMINI_PRICE_OUT_PER_M=10.00
