# Copy to .env. Leave a key empty to use the mock for that part.
MONGODB_URI=                 # empty = in-memory mongomock
MONGODB_DB=tripcheck

SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_MODEL=subq-snap-1.1     # or DECISION_MODEL; confirm with GET /v1/models

GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon  # or VERIFIER_MODEL; confirm exact ID in AI Studio

AGENT_SEED_PHRASE=           # REQUIRED before Agentverse: long random secret (agent identities derive from it)
STRIPE_TEST_KEY=             # sk_test_... ONLY. Never a live key.

DEMO_NOW=                    # e.g. 2026-11-18T10:00:00 to demo mid-trip changes
MAX_LOOPS=3                  # MAX_REPAIR_ROUNDS also accepted
MOCK=                        # e.g. subq,gemini forces mocks even with keys set
BOOKING_DRY_RUN=true         # true = mock payments; false + sk_test key = Stripe test mode
AGENTS_USE_MAILBOX=false     # true = register booking agents on Agentverse (needs internet)
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=
# Prices for the scoreboard, USD per 1M tokens. Confirm on each console.
SUBQ_PRICE_IN_PER_M=0.05
GEMINI_PRICE_IN_PER_M=2.00
GEMINI_PRICE_OUT_PER_M=10.00
